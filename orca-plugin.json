{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "b-side",
  "name": "B-Side",
  "version": "1.0.0",
  "description": "Control AIMP from Orca — your lossless collection while you work",
  "license": "MIT",
  "homepage": "https://github.com/icaceresc/b-side",
  "repository": "https://github.com/icaceresc/b-side",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.mjs",
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "player",
        "title": "B-Side",
        "icon": "play",
        "entry": "panel/index.html"
      }
    ]
  }
}
